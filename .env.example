# Database
DATABASE_URL="postgresql://user:password@localhost:5432/songcal"

# Sync interval in milliseconds (optional, default: 60000 = 1 minute)
# SYNC_INTERVAL_MS="60000"

# Apple Music
APPLE_TEAM_ID="your_team_id"
APPLE_KEY_ID="your_key_id"
APPLE_PRIVATE_KEY="./AuthKey_XXXXXX.p8"

# Google Calendar
GOOGLE_CLIENT_ID="your_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_client_secret"

# Google Calendar name (optional, default: "Apple Music")
# GOOGLE_CALENDAR_NAME="Apple Music"
