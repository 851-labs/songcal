{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "songcal",
  "compatibility_date": "2025-12-10",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "workers_dev": true,
  "preview_urls": true,
  "placement": {
    "mode": "smart",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1.0,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1.0,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1.0,
      "persist": true,
    },
  },
  "routes": [
    {
      "pattern": "songcal.sh",
      "custom_domain": true,
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://songcal.sh",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "songcal",
      "database_id": "ef1d5722-20ff-446a-b308-cc2178bd1bab",
      "migrations_dir": "drizzle/migrations",
    },
  ],
  "queues": {
    "producers": [
      {
        "queue": "songcal-sync",
        "binding": "SYNC_QUEUE",
      },
    ],
    "consumers": [
      {
        "queue": "songcal-sync",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
      },
    ],
  },
  "triggers": {
    "crons": ["* * * * *"],
  },
  "workflows": [
    {
      "name": "backfill-artwork-workflow",
      "binding": "BACKFILL_ARTWORK_WORKFLOW",
      "class_name": "BackfillArtworkWorkflow",
    },
  ],
}
