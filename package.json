{
  "name": "songcal",
  "version": "2.0.0",
  "private": true,
  "description": "Sync Apple Music listening history to Google Calendar",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && tsc --noEmit",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --fix --type-aware --type-check",
    "db:migrations:generate": "drizzle-kit generate",
    "db:migrations:list": "wrangler d1 migrations list DB --local",
    "db:migrations:list:prod": "wrangler d1 migrations list DB --remote",
    "db:migrations:apply": "wrangler d1 migrations apply DB --local",
    "db:migrations:apply:prod": "wrangler d1 migrations apply DB --remote",
    "cron:trigger": "curl 'http://localhost:3000/cdn-cgi/handler/scheduled?cron=*+*+*+*+*'"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "@fontsource-variable/figtree": "^5.2.10",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-router": "^1.157.14",
    "@tanstack/react-router-ssr-query": "^1.157.14",
    "@tanstack/react-start": "^1.157.14",
    "better-auth": "^1.4.17",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "jose": "^6.1.3",
    "lucide-react": "^0.563.0",
    "ms": "^2.1.3",
    "nanoid": "^5.1.6",
    "onedollarstats": "^0.0.11",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.4.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.21.2",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/router-plugin": "^1.157.14",
    "@types/apple-music-api": "^0.4.4",
    "@types/ms": "^2.1.0",
    "@types/musickit-js": "^1.0.11",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "drizzle-kit": "^0.31.8",
    "lefthook": "^2.0.15",
    "oxfmt": "^0.26.0",
    "oxlint": "^1.41.0",
    "oxlint-tsgolint": "^0.11.1",
    "shadcn": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.5",
    "wrangler": "^4.60.0"
  }
}
